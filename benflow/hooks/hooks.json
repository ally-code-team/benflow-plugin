{
  "description": "Ao abrir o Claude Code numa pasta de repositório da organização, mostra um resumo curto dos chamados abertos do Benflow. Nessas pastas, avisa o Benflow quando a sessão abre, trabalha, espera você ou fecha, para o quadro mostrar quem está no terminal agora (o estado, o repositório, a branch, o nome da pasta e a máquina). Nessas pastas, o seu pedido e a resposta do Claude também aparecem na sua conversa com este Claude no Terminal do Claude do painel, que só você lê (os segredos conhecidos saem mascarados; dos comandos e arquivos vai só a descrição e o nome). Para não mandar o texto, defina BENFLOW_ESPELHO=0; BENFLOW_PRESENCA=0 desliga os dois.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/benflow.mjs", "sessao"],
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/presenca.mjs"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/presenca.mjs"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/presenca.mjs"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/presenca.mjs"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/presenca.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
